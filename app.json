{
  "expo": {
    "name": "라이트런",
    "slug": "light-run",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ringwdr.lightrun"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.ringwdr.lightrun"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B3A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "달리는 동안 거리와 페이스를 기록하려고 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": "화면이 꺼져 있어도 달리기 기록이 끊기지 않도록 위치를 사용해요. 기록 중에만 사용해요.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/with-notification-icon",
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.adapters.react.apploader.RNHeadlessAppLoader { *; }"
          }
        }
      ]
    ],
    "scheme": "lightrun",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d31e932e-6e10-44bc-9def-cae5518950a7"
      }
    },
    "owner": "ring-wdr"
  }
}
