# 복사해서 .env로 저장한 뒤 값을 채운다(.env는 gitignore). 공유용 APK(EAS)는 .env를 읽지 않으니 EAS 환경 변수로 등록한다(README).

# Google Maps SDK 키(기록 상세 지도). Android 앱 제한 키
GOOGLE_MAPS_API_KEY=
# iOS용 키(없으면 Android 키를 쓴다)
# GOOGLE_MAPS_IOS_API_KEY=

# Mapbox 공개 토큰(pk.로 시작). 3D 다시 보기 화면에서만 쓴다. 비밀 토큰(sk.)은 넣지 않는다(필요 없음)
EXPO_PUBLIC_MAPBOX_TOKEN=
