{
  "name": "light-run",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "babel-preset-expo": "^57.0.13",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "~26.6.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "report:filter": "jest --testMatch '<rootDir>/tests/report/**/*.report.ts'",
    "doctor": "expo-doctor",
    "prebuild:android": "expo prebuild --clean --platform android",
    "android:release": "expo prebuild --clean --platform android && expo run:android --variant release --device",
    "lint": "expo lint src tests --max-warnings 0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "projects": [
      {
        "preset": "jest-expo/android",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup.tsx"
        ]
      },
      {
        "preset": "jest-expo/ios",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup.tsx"
        ]
      }
    ]
  }
}
